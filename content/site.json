  "description": {
    "zh": "数学、算法与 AI 的笔记：结构、机制与边界。",
    "en": "Notes on mathematics, algorithms and AI: structure, mechanism and boundary."
  },
  "statement": {
    "zh": "这里记录数学、算法与 AI 中值得反复理解的问题：结论依赖怎样的结构，方法为何有效，又在什么条件下失效。",
    "en": "Notes on the questions in mathematics, algorithms and AI that are worth understanding more than once: what structure a result depends on, why a method works, and under what conditions it fails."
  },
  "principles": [
    {
      "label": "STRUCTURE",
      "title": {
        "zh": "数学澄清结构",
        "en": "Mathematics clarifies structure"
      },
      "desc": {
        "zh": "从定义、假设与推导中找出真正决定结论的部分。",
        "en": "Find, among definitions, assumptions and derivations, the part that actually decides the result."
      }
    },
    {
      "label": "MECHANISM",
      "title": {
        "zh": "算法解释过程",
        "en": "Algorithms explain process"
      },
      "desc": {
        "zh": "关注不变量、信息流与计算步骤，而不只给出结果。",
        "en": "Follow invariants, information flow and computational steps instead of only stating the outcome."
      }
    },
    {
      "label": "BOUNDARY",
      "title": {
        "zh": "核验标出边界",
        "en": "Verification marks the boundary"
      },
      "desc": {
        "zh": "用反例、实验与来源说明结论何时成立、何时失效。",
        "en": "Use counterexamples, experiments and sources to show when a claim holds and when it breaks."
      }
    }
  ],
